ey zone disruptions",2],[". For the Kremlin, cable sabotage is ",1],["an ",2],["asymmetric enabler",2],[", especially in",2],[" case of ",1],["escalation",2],[" or",2],[" at ",1],["the ",2],["initial period",2],[" of war",1],[", potentially ",1],["giving Moscow ",2],["greater decision-making speed",2],[" against",2],[" an ",1],["adversary",2],[" in the ",1],["early stages",1],[" of a conflict. The intended objective is ",1],["to ",2],["blunt",2],[" an opponent’s",2],[" ",1],["ability to respond",1],[" by limiting or shutting down ",1],["military",2],[" and/or ",2],["civilian comm",2],["unication",1],["s",2],[" at the ",1],["onset",1],[" of a conflict",1],[". 64",0]],[["The Kremlin devolves resources to map submarine cables and conduct intelligence gathering operations. In this effort, ",0],["seabed warfare has an ",1],["intelligence function",1],[" in Russia",1],[", and not necessarily a naval one. 65 ",0],["Cable operations",2],[" represent an important tool in the informational and psychological preparation of the battlespace, with the ",1],["aim to ",1],["break",2],[" Western",2],[" civilian ",1],["support",2],[" in a potential ",1],["escalation scenario",1],[" with Russia",1],[". 66 ",0]],[["The situation is compounded by the fact that ",0],["Russia has",2],[" a strong ",1],["incentive to probe",2],[" the seabed",1],[" in order ",1],["to ",2],["test",2],[" the ",1],["resolve",2],[" and ",1],["response",1],[" ",1],["of",2],[" Western countries and ",0],["NATO. More ",2],["provocations",2],[" and ",1],["disruptions",1],[" can therefore be expected in the short and medium terms",1],[". In turn, ",0],["this",1],[" situation ",0],["increase",2],["s the ",1],["risk of ",2],["miscalculation",2],[", ",1],["tactical ",1],["errors",2],[", and",2],[" ",1],["horizontal ",1],["escalation",2],[".",0]]],"url":"https://www.wilsoncenter.org/publication/arctic-seabed-warfare-against-data-cables-risks-and-impact-us-critical-undersea,"}